# Copy this file to ".env" and fill in your real values. Never commit ".env" itself.

PORT=5000

# Your site's real domain once deployed (e.g. https://karunyasharma.dev)
# Use "*" only while testing locally.
ALLOWED_ORIGIN=*

# --- SMTP settings ---
# Gmail example: host smtp.gmail.com, port 587
# You MUST use a Gmail "App Password", not your normal password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password

# Where contact form messages get delivered (defaults to SMTP_USER if omitted)
RECEIVING_EMAIL=karunyasharma60@gmail.com
